{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/monthly-report-v0.1.schema.json",
  "title": "Monthly Trace Report v0.1",
  "description": "Schema for the GitHub Trace Return Extension v0.1 monthly trace report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "month",
    "repository",
    "trace_return_enabled",
    "estimated_trace_score",
    "signal_breakdown",
    "return_recommendation",
    "anti_gaming_review"
  ],
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "Reporting month in YYYY-MM format."
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
      "description": "Repository in owner/repo format."
    },
    "trace_return_enabled": {
      "type": "boolean",
      "description": "Whether trace return was enabled for the repository during the reporting month."
    },
    "estimated_trace_score": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated trace contribution score."
    },
    "signal_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_signal",
        "maintenance_signal",
        "interaction_signal",
        "quality_signal"
      ],
      "properties": {
        "structural_signal": {
          "type": "number",
          "minimum": 0
        },
        "maintenance_signal": {
          "type": "number",
          "minimum": 0
        },
        "interaction_signal": {
          "type": "number",
          "minimum": 0
        },
        "quality_signal": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "return_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rail",
        "suggested_return_tier"
      ],
      "properties": {
        "rail": {
          "type": "string",
          "enum": [
            "github_sponsors",
            "copilot_credits",
            "actions_credits",
            "none"
          ],
          "description": "Suggested return rail."
        },
        "suggested_return_tier": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "description": "Suggested return tier."
        }
      }
    },
    "anti_gaming_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "notes"
      ],
      "properties": {
        "passed": {
          "type": "boolean",
          "description": "Whether the report passed anti-gaming review."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable anti-gaming review note."
        }
      }
    }
  }
}
