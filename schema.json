{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/trace-return-v0.1.schema.json",
  "title": "Trace Return Extension v0.1",
  "description": "Schema for the GitHub Trace Return Extension v0.1 repository-level configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace_return"],
  "properties": {
    "trace_return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "version",
        "scope",
        "attribution_mode",
        "monthly_report",
        "return_rail"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the repository participates in the Trace Return system."
        },
        "version": {
          "type": "string",
          "const": "0.1",
          "description": "Specification version."
        },
        "scope": {
          "type": "string",
          "enum": ["public_repository_only"],
          "description": "Participation scope for v0.1."
        },
        "attribution_mode": {
          "type": "string",
          "enum": [
            "interaction_estimate",
            "repository_signal_estimate"
          ],
          "description": "How contribution is estimated."
        },
        "monthly_report": {
          "type": "boolean",
          "description": "Whether monthly trace reporting is enabled."
        },
        "return_rail": {
          "type": "string",
          "enum": [
            "github_sponsors",
            "copilot_credits",
            "actions_credits",
            "none"
          ],
          "description": "Primary return route."
        }
      }
    },
    "anti_gaming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fork_deduplication",
        "score_cap",
        "spam_filter"
      ],
      "properties": {
        "fork_deduplication": {
          "type": "boolean",
          "description": "Reduce duplicate counting across forks or mirrors."
        },
        "score_cap": {
          "type": "boolean",
          "description": "Limit excessive concentration of contribution score."
        },
        "spam_filter": {
          "type": "string",
          "enum": ["basic", "strict"],
          "description": "Anti-spam filtering mode."
        }
      }
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sponsors_handle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
          "description": "GitHub Sponsors handle of the maintainer."
        }
      }
    }
  }
}
